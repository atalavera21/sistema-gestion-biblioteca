# =============================================================================
# Plantilla de variables de entorno — Biblioteca SENATI
#
# Copia este archivo como ".env" y coloca TUS PROPIAS claves.
# El archivo ".env" esta en .gitignore: NO se sube a GitHub.
#
#   Windows PowerShell:  Copy-Item .env.example .env
#   Linux / VPS:         cp .env.example .env
#
# Usa claves alfanumericas (letras y numeros). Para el VPS, claves fuertes.
# =============================================================================

# Usuario de la base de datos que usa la aplicacion
DB_USER=biblioteca

# Clave de ese usuario
DB_PASSWORD=cambia-esta-clave

# Clave del usuario root de MySQL
DB_ROOT_PASSWORD=cambia-esta-clave-root
